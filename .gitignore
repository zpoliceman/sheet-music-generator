# 本机环境、外部软件、模型与缓存。
/.tools/
/.runtime/
.venv*/
.cache/
/third_party/
/data/

# 私人素材、曲谱、配置、运行报告、备份与临时数据。
/test_music/
/test_outputs/
/results/
/reports/
/history-version/
/tmp/
artifacts/

# 协作资料和个人教学资料留在本机；根目录只公开简短README。
/maintained/
/docs/
/*.md
!/README.md
AGENTS.md
HANDOFF.md
todo.md
progress.md
README_accompaniment.md
GitHub上传与持续更新教程.md

# 开发验证及一次性维护脚本不属于运行包。
/tests/

# 自动生成文件和本机凭据。
__pycache__/
*.py[cod]
*.log
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
Thumbs.db
Desktop.ini
.DS_Store

# 本地桌面可执行文件由desktop/build.ps1编译。
/弦页制谱.exe
/desktop/*.pdb
